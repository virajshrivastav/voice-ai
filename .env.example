# Copy to .env. Never commit .env.
# With every value below left empty, the whole system still runs on mock providers:
#   python -m stage1.dryrun --lang mr-IN
#   python -m stage0.bakeoff --lang mr-IN --providers mock --voice-id demo

# --- mode ---------------------------------------------------------------------
# demo       relaxes the answer-bank approval gate. Development only.
# production requires an approved answer bank AND a stored voice-consent artefact.
MODE=demo

CALL_LANG=mr-IN            # or hi-IN for tests
TTS_PROVIDER=mock          # mock | smallest | sarvam
STT_PROVIDER=mock          # mock | sarvam
VOICE_ID=                  # cloned voice id, chosen after the Stage 0 bake-off

# --- the consented speaker ----------------------------------------------------
# These fill the [नाव] / [मतदारसंघ] / [कार्यालय क्रमांक] placeholders in data/*.yaml.
SPEAKER_NAME=
SPEAKER_CONSTITUENCY=
OFFICE_CONTACT=
# Reference to the signed + recorded consent (docs/02_COMPLIANCE.md §3).
# Production refuses to synthesise anything without it.
VOICE_CONSENT_REF=

# --- vendors ------------------------------------------------------------------
SARVAM_API_KEY=
SMALLEST_API_KEY=
CARTESIA_API_KEY=
# Override if Smallest moves cloning off the documented lightning-large path.
SMALLEST_CLONE_URL=

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

DATABASE_URL=postgresql://user:pass@localhost:5432/voice_ai
